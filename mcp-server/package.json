{
  "name": "calistenia-server",
  "version": "1.0.0",
  "description": "Unified server for Calistenia App — REST API + MCP tools for Claude",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "mcp-use build --path . --entry src/server.ts",
    "build:server": "rm -rf build && tsc",
    "start": "mcp-use start --path .",
    "dev": "mcp-use dev --path . --entry src/server.ts --no-open",
    "dev:simple": "tsx src/standalone.ts",
    "seed": "node build/seed.js",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit && tsc -p tsconfig.views.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@calistenia/core": "file:../packages/core",
    "@ai-sdk/anthropic": "^4.0.27",
    "@ai-sdk/google": "^4.0.31",
    "@ai-sdk/openai": "^4.0.27",
    "@ai-sdk/otel": "^1.0.48",
    "@langfuse/core": "^5.10.0",
    "@langfuse/otel": "^5.10.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "ai": "^7.0.48",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^3.15.0",
    "google-auth-library": "^11.0.2",
    "langfuse": "^3.38.20",
    "mcp-use": "^2.2.3",
    "mustache": "^4.2.0",
    "pocketbase": "^0.27.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.5",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
