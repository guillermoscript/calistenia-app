{
  "name": "calistenia-server",
  "version": "1.0.0",
  "description": "Unified server for Calistenia App — REST API + MCP tools for Claude",
  "type": "module",
  "scripts": {
    "build": "mcp-use build --path . --entry src/server.ts --widgets-dir resources",
    "build:server": "rm -rf build && tsc",
    "start": "node build/server.js",
    "dev": "mcp-use dev --path . --entry src/server.ts --widgets-dir resources --no-open",
    "dev:simple": "tsx src/server.ts",
    "seed": "node build/seed.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.32",
    "@ai-sdk/google": "^4.0.35",
    "@ai-sdk/openai": "^4.0.31",
    "@ai-sdk/otel": "^1.0.54",
    "@langfuse/core": "^5.10.0",
    "@langfuse/otel": "^5.10.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "ai": "^7.0.48",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^3.15.0",
    "google-auth-library": "^10.9.1",
    "langfuse": "^3.38.20",
    "mcp-use": "^1.34.6",
    "pocketbase": "^0.27.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3"
  }
}
