// Typecheck-only config for the MCP App Views (`views/**`). They are bundled
// by Vite through `mcp-use build`, which does NOT type-check, and they live
// outside `src/` so `tsconfig.typecheck.json` never sees them either. Their
// `Props` types come from `src/views/*.schema.ts`, so this is what catches a
// View reading a field the tool's `outputSchema` no longer declares.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["views/**/*.ts", "views/**/*.tsx", "src/views/*.ts", "mcp-env.d.ts"]
}
